<Window x:Class="PersonalAppsHub.ResponsePreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Réponse proposée" Width="720" Height="520" MinWidth="560" MinHeight="400" WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}">
  <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Réponse proposée" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Vous pouvez modifier la réponse avant de remplacer le texte sélectionné." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,14"/></StackPanel>
    <TextBox x:Name="ResponseText" Grid.Row="1" Height="Auto" MinHeight="240" AcceptsReturn="True" TextWrapping="Wrap"
             VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="14"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0"><Button x:Name="CancelButton" Content="Annuler" Style="{StaticResource ButtonStyle}" Margin="0,0,9,0"/><Button x:Name="AcceptButton" Content="Remplacer" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel>
  </Grid>
</Window>
