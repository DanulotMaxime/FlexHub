<Window x:Class="PersonalAppsHub.XmpAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alerte XMP" Width="440" Height="230"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True"
        Background="Transparent" AllowsTransparency="True">
  <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentBrightBrush}" BorderThickness="2" CornerRadius="16" Padding="22">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
        <Border Width="44" Height="44" CornerRadius="22" Background="#FF4A3425" Margin="0,0,14,0"><TextBlock Text="!" Foreground="#FFF0AE72" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel VerticalAlignment="Center"><TextBlock Text="XMP semble désactivé" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/><TextBlock Text="Une action de votre part est nécessaire." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
      </StackPanel>
      <TextBlock x:Name="AlertMessage" Grid.Row="1" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,18,0,12" FontSize="14"/>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="DismissButton" Content="Ne rien faire" Style="{StaticResource ButtonStyle}" Margin="0,0,10,0"/>
        <Button x:Name="RestartButton" Content="Redémarrer maintenant" Style="{StaticResource PrimaryButtonStyle}"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
