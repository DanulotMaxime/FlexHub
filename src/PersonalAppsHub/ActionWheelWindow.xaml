<Window x:Class="PersonalAppsHub.ActionWheelWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" Height="380" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize">
  <Grid>
    <Ellipse Width="330" Height="330" Fill="#E622201E" Stroke="{DynamicResource AccentBrightBrush}" StrokeThickness="2"/>
    <Ellipse Width="112" Height="112" Fill="#FF171616" Stroke="#FF66574B" StrokeThickness="1"/>
    <Border x:Name="CorrectionZone" Width="146" Height="64" CornerRadius="18" Background="#FF332B26" BorderBrush="#FF6A584B" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="✓" FontSize="20" Foreground="#FFF0AE72" HorizontalAlignment="Center"/><TextBlock Text="CORRIGER" Foreground="White" FontWeight="SemiBold"/></StackPanel>
    </Border>
    <Border x:Name="TranslationZone" Width="146" Height="64" CornerRadius="18" Background="#FF332B26" BorderBrush="#FF6A584B" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="⇄" FontSize="20" Foreground="#FFF0AE72" HorizontalAlignment="Center"/><TextBlock Text="TRADUIRE" Foreground="White" FontWeight="SemiBold"/></StackPanel>
    </Border>
    <Border x:Name="ResponseZone" Width="146" Height="64" CornerRadius="18" Background="#FF332B26" BorderBrush="#FF6A584B" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="✦" FontSize="20" Foreground="#FFF0AE72" HorizontalAlignment="Center"/><TextBlock Text="RÉPONDRE" Foreground="White" FontWeight="SemiBold"/></StackPanel>
    </Border>
    <Border x:Name="CancelZone" Width="146" Height="64" CornerRadius="18" Background="#FF332B26" BorderBrush="#FF6A584B" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="×" FontSize="20" Foreground="#FFFF7F7F" HorizontalAlignment="Center"/><TextBlock Text="ANNULER" Foreground="White" FontWeight="SemiBold"/></StackPanel>
    </Border>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="100"><TextBlock x:Name="CurrentActionText" Text="Survolez" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="pour choisir" Foreground="#FFBDB7B2" FontSize="11" HorizontalAlignment="Center"/></StackPanel>
  </Grid>
</Window>
