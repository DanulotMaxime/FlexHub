<Window x:Class="PersonalAppsHub.ActionWheelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="960" Height="760" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" ResizeMode="NoResize">
  <Window.Resources>
    <Style x:Key="WheelActionZoneStyle" TargetType="Border">
      <Setter Property="Width" Value="288"/>
      <Setter Property="Height" Value="68"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Background" Value="#F02A2725"/>
      <Setter Property="BorderBrush" Value="#FF6A584B"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="WheelActionTitleStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="WheelActionHintStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFF0AE72"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
  </Window.Resources>

  <Canvas x:Name="WheelCanvas" Width="960" Height="760">
    <!-- Les actions sont réparties dynamiquement autour du centre. -->
    <Border x:Name="CorrectionZone" Style="{StaticResource WheelActionZoneStyle}" Canvas.Left="20" Canvas.Top="10">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="✓  CORRIGER" Style="{StaticResource WheelActionTitleStyle}"/>
        <TextBlock Text="Correction du texte sélectionné" Style="{StaticResource WheelActionHintStyle}"/>
      </StackPanel>
    </Border>

    <Border x:Name="ReformulateZone" Style="{StaticResource WheelActionZoneStyle}" Canvas.Left="120" Canvas.Top="84">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="↻  REFORMULER" Style="{StaticResource WheelActionTitleStyle}"/>
        <TextBlock Text="Même sens, formulation plus fluide" Style="{StaticResource WheelActionHintStyle}"/>
      </StackPanel>
    </Border>

    <Border x:Name="SimplifyZone" Style="{StaticResource WheelActionZoneStyle}" Canvas.Left="220" Canvas.Top="158">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="≡  SIMPLIFIER" Style="{StaticResource WheelActionTitleStyle}"/>
        <TextBlock Text="Version claire et facile à comprendre" Style="{StaticResource WheelActionHintStyle}"/>
      </StackPanel>
    </Border>

    <Border x:Name="TranslationForwardZone" Style="{StaticResource WheelActionZoneStyle}" Canvas.Left="320" Canvas.Top="232">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="⇄  TRADUIRE" Style="{StaticResource WheelActionTitleStyle}"/>
        <TextBlock x:Name="TranslationForwardText" Style="{StaticResource WheelActionHintStyle}"/>
      </StackPanel>
    </Border>

    <Border x:Name="CancelZone" Width="230" Height="230" CornerRadius="115" Canvas.Left="365" Canvas.Top="265"
            Background="#F0171616" BorderBrush="{DynamicResource AccentBrightBrush}" BorderThickness="2">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="×" FontSize="44" Foreground="#FFFF7F7F" HorizontalAlignment="Center"/>
        <TextBlock Text="ANNULER" Foreground="White" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock x:Name="CurrentActionText" Text="Déplacez le pointeur" Foreground="#FFBDB7B2"
                   FontSize="11" Margin="0,7,0,0" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <Border x:Name="TranslationReverseZone" Style="{StaticResource WheelActionZoneStyle}" Canvas.Left="320" Canvas.Top="306">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="⇆  TRADUIRE" Style="{StaticResource WheelActionTitleStyle}"/>
        <TextBlock x:Name="TranslationReverseText" Style="{StaticResource WheelActionHintStyle}"/>
      </StackPanel>
    </Border>

    <Border x:Name="CustomToneZone" Style="{StaticResource WheelActionZoneStyle}" Canvas.Left="270" Canvas.Top="380">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="✦  TON PERSONNALISÉ" Style="{StaticResource WheelActionTitleStyle}"/>
        <TextBlock Text="Générer avec le ton configuré" Style="{StaticResource WheelActionHintStyle}"/>
      </StackPanel>
    </Border>

    <Border x:Name="SummarizeZone" Style="{StaticResource WheelActionZoneStyle}" Canvas.Left="170" Canvas.Top="454">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="☷  RÉSUMER UNE CONVERSATION" Style="{StaticResource WheelActionTitleStyle}"/>
        <TextBlock Text="Extraire l’essentiel, les décisions et les tâches" Style="{StaticResource WheelActionHintStyle}"/>
      </StackPanel>
    </Border>

    <Border x:Name="DefineWordZone" Style="{StaticResource WheelActionZoneStyle}" Canvas.Left="70" Canvas.Top="528">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="?  DÉFINITION D’UN MOT" Style="{StaticResource WheelActionTitleStyle}"/>
        <TextBlock Text="Expliquer le sens dans son contexte" Style="{StaticResource WheelActionHintStyle}"/>
      </StackPanel>
    </Border>
  </Canvas>
</Window>
