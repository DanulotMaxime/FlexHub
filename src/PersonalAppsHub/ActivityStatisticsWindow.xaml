<Window x:Class="PersonalAppsHub.ActivityStatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Statistiques et historique d’activité" Width="1040" Height="760"
        MinWidth="820" MinHeight="620" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Statistiques et historique" FontSize="27" FontWeight="SemiBold"/>
      <TextBlock x:Name="HistorySummary" Foreground="{DynamicResource AccentBrightBrush}" Margin="0,7,0,16" TextWrapping="Wrap"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
      <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="16">
        <StackPanel>
          <TextBlock Text="ACTIVITÉ DES 7 DERNIERS JOURS" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
          <ItemsControl x:Name="DayChart"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Grid Height="185" Margin="5"><Grid.RowDefinitions><RowDefinition Height="135"/><RowDefinition Height="25"/><RowDefinition Height="25"/></Grid.RowDefinitions><Border VerticalAlignment="Bottom" Height="{Binding BarHeight}" Background="{DynamicResource AccentBrush}" CornerRadius="5,5,0,0" ToolTip="{Binding Tooltip}"/><TextBlock Grid.Row="1" Text="{Binding DayText}" HorizontalAlignment="Center" Foreground="{DynamicResource TextBrush}" FontSize="11" Margin="0,5,0,0"/><TextBlock Grid.Row="2" Text="{Binding DurationText}" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrightBrush}" FontSize="10"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </Border>
      <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,14,0,0"><StackPanel>
        <TextBlock Text="APPLICATIONS LES PLUS UTILISÉES" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
        <ItemsControl x:Name="ApplicationChart"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Border Grid.Column="1" Width="{Binding BarWidth}" MaxWidth="500" Height="16" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" CornerRadius="3"/><TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="{DynamicResource AccentBrightBrush}" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></Border>
      <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,14,0,0"><StackPanel>
        <TextBlock Text="FICHIERS RÉCENTS CONSERVÉS DANS L’HISTORIQUE" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
        <ListView x:Name="RecentFiles" Height="230" AlternationCount="2" Background="{DynamicResource PanelLightBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextBrush}" SelectionChanged="RecentFiles_OnSelectionChanged" MouseDoubleClick="RecentFiles_OnMouseDoubleClick">
          <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}"><Setter Property="Background" Value="{DynamicResource PanelLightBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="4,3"/><Style.Triggers><Trigger Property="ItemsControl.AlternationIndex" Value="1"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#FF214554"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FF24627A"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style></ListView.ItemContainerStyle>
          <ListView.View><GridView><GridViewColumn Header="Fichier" Width="270" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="Dossier" Width="390" DisplayMemberBinding="{Binding Folder}"/><GridViewColumn Header="Modification" Width="145" DisplayMemberBinding="{Binding ModifiedText}"/></GridView></ListView.View>
        </ListView>
        <Border x:Name="ImagePreviewBorder" Visibility="Collapsed" Background="{DynamicResource PanelLightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,10,0,0" HorizontalAlignment="Left"><StackPanel><TextBlock Text="APERÇU DE L’IMAGE" Foreground="{DynamicResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/><Image x:Name="ImagePreview" Width="260" Height="150" Stretch="Uniform"/></StackPanel></Border>
        <TextBlock x:Name="FileStatus" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><Button x:Name="OpenLocation" Content="Ouvrir l’emplacement" Style="{StaticResource ButtonStyle}" IsEnabled="False" Margin="0,0,8,0" Click="OpenLocation_OnClick"/><Button x:Name="OpenFile" Content="Ouvrir le fichier" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" Click="OpenFile_OnClick"/></StackPanel>
      </StackPanel></Border>
    </StackPanel></ScrollViewer>
    <Button Grid.Row="2" Content="Fermer" Style="{StaticResource ButtonStyle}" HorizontalAlignment="Right" Margin="0,14,0,0" Click="Close_OnClick"/>
  </Grid>
</Window>
