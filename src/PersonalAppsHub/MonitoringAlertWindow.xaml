<Window x:Class="PersonalAppsHub.MonitoringAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alerte monitoring" Width="460" Height="250"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True"
        Background="Transparent" AllowsTransparency="True">
  <Border Background="{DynamicResource PanelBrush}" BorderBrush="#FFFFB36B" BorderThickness="2" CornerRadius="16" Padding="22">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
        <Border Width="46" Height="46" CornerRadius="23" Background="#FF4A3425" Margin="0,0,14,0">
          <TextBlock Text="!" Foreground="#FFFFB36B" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="AlertTitle" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
          <TextBlock Text="Une limite configurée vient d’être dépassée." Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Row="1" Margin="0,18,0,12">
        <TextBlock x:Name="AlertMessage" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" FontSize="14"/>
        <TextBlock Text="FlexHub attend trois mesures consécutives avant d’afficher cette alerte." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
      </StackPanel>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="DismissButton" Content="Ignorer" Style="{StaticResource ButtonStyle}" Margin="0,0,10,0"/>
        <Button x:Name="OpenMonitoringButton" Content="Ouvrir le monitoring" Style="{StaticResource PrimaryButtonStyle}"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
