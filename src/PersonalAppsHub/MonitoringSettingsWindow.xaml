<Window x:Class="PersonalAppsHub.MonitoringSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alertes du monitoring" Width="580" Height="680" MinWidth="540" MinHeight="560" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource BaseFontSize}">
  <Border Margin="18" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><StackPanel><TextBlock Text="Alertes de surveillance" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Soyez prévenu lorsqu’une ressource reste au-dessus de sa limite." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><ToggleButton x:Name="AlertsEnabled" Style="{StaticResource ToggleStyle}"/><TextBlock Text="Activées" Margin="9,0,0,0" VerticalAlignment="Center"/></StackPanel></Grid>
      <Border Grid.Row="1" Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,20"/>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,0">
        <TextBlock Text="Une alerte est envoyée uniquement après 3 mesures consécutives (environ 9 secondes). Elle ne se répète pas pendant 15 minutes." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
        <Border Background="{DynamicResource PanelLightBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Utilisation du processeur" FontWeight="SemiBold"/><TextBlock Text="Alerter lorsque le CPU atteint cette valeur." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/><TextBlock Text="Valeur conseillée : 95 %" Foreground="{DynamicResource AccentBrightBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel><Grid Grid.Column="1"><TextBox x:Name="CpuThreshold"/><TextBlock Text="%" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}"/></Grid></Grid></Border>
        <Border Background="{DynamicResource PanelLightBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Utilisation de la mémoire" FontWeight="SemiBold"/><TextBlock Text="Alerter lorsque la RAM atteint cette valeur." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/><TextBlock Text="Valeur conseillée : 90 %" Foreground="{DynamicResource AccentBrightBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel><Grid Grid.Column="1"><TextBox x:Name="RamThreshold"/><TextBlock Text="%" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}"/></Grid></Grid></Border>
        <Border Background="{DynamicResource PanelLightBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Température du processeur" FontWeight="SemiBold"/><TextBlock Text="Alerter lorsque le CPU atteint cette température." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/><TextBlock Text="Valeur conseillée : 90 °C" Foreground="{DynamicResource AccentBrightBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel><Grid Grid.Column="1"><TextBox x:Name="CpuTemperatureThreshold"/><TextBlock Text="°C" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}"/></Grid></Grid></Border>
        <Border Background="{DynamicResource PanelLightBrush}" CornerRadius="10" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Température de la carte graphique" FontWeight="SemiBold"/><TextBlock Text="Disponible avec les cartes NVIDIA et AMD compatibles." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/><TextBlock Text="Valeur conseillée : 85 °C" Foreground="{DynamicResource AccentBrightBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel><Grid Grid.Column="1"><TextBox x:Name="GpuTemperatureThreshold"/><TextBlock Text="°C" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}"/></Grid></Grid></Border>
      </StackPanel></ScrollViewer>
      <TextBlock x:Name="ValidationStatus" Grid.Row="3" Foreground="#FFFFB36B" Margin="0,14,0,0" TextWrapping="Wrap"/>
      <Grid Grid.Row="4" Margin="0,18,0,0"><Button x:Name="TestAlert" Content="Tester l’alerte" Style="{StaticResource ButtonStyle}" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Annuler" Style="{StaticResource ButtonStyle}" Margin="0,0,8,0"/><Button x:Name="Save" Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel></Grid>
    </Grid>
  </Border>
</Window>
