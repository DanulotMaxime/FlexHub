<Window x:Class="PersonalAppsHub.TranslationPreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traduction proposée" Width="540" Height="330" WindowStyle="ToolWindow" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" Topmost="True">
  <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Traduction proposée" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Vérifiez le résultat avant de remplacer la sélection." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,14"/></StackPanel>
    <TextBox x:Name="TranslatedText" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="Auto" VerticalContentAlignment="Top"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0"><Button x:Name="CancelButton" Content="Annuler" Style="{StaticResource ButtonStyle}" Margin="0,0,9,0"/><Button x:Name="AcceptButton" Content="Remplacer" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel>
  </Grid>
</Window>
