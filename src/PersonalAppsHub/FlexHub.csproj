<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FlexHub</AssemblyName>
    <ApplicationIcon>..\..\assets\app-logo.ico</ApplicationIcon>
    <RootNamespace>PersonalAppsHub</RootNamespace>
    <Version>1.4.1</Version>
    <Company>Flexron</Company>
    <Product>FlexHub</Product>
    <Description>Hub Windows regroupant des outils personnels et des profils NVIDIA.</Description>
    <Authors>Flexron</Authors>
    <Copyright>Copyright © 2026 Flexron</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\assets\app-logo.png" Link="Assets\app-logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\app-logo.ico" Link="Assets\app-logo.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="CHANGELOG.md" Link="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\PRIVACY.md" Link="PRIVACY.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSES\NVIDIA-PROFILE-INSPECTOR.txt" Link="LICENSES\NVIDIA-PROFILE-INSPECTOR.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSES\VORTICE-WINDOWS.txt" Link="LICENSES\VORTICE-WINDOWS.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\tools\nvidia-profile-inspector\nvidiaProfileInspector.exe" Link="Tools\nvidiaProfileInspector.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\nvidia-profile-inspector\Reference.xml" Link="Tools\Reference.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\nvidia-profiles\NVIDIA-Global-Profile-Baseline.nip" Link="Profiles\NVIDIA-Global-Profile-Baseline.nip" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
  </ItemGroup>
</Project>
