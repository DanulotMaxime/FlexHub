<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FlexHub</AssemblyName>
    <RootNamespace>PersonalAppsHub</RootNamespace>
    <Version>1.0.0</Version>
    <Company>Flexron</Company>
    <Product>FlexHub</Product>
    <Description>Hub Windows regroupant des outils personnels et des profils NVIDIA.</Description>
    <Authors>Flexron</Authors>
    <Copyright>Copyright © 2026 Flexron</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\assets\app-logo.png" Link="Assets\app-logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="CHANGELOG.md" Link="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\PRIVACY.md" Link="PRIVACY.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
