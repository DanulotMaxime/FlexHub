<Window x:Class="PersonalAppsHub.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlexHub" Width="1120" Height="780" MinWidth="1000" MinHeight="720" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource BaseFontSize}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="60" Height="60" CornerRadius="30" BorderBrush="{StaticResource AccentBrightBrush}" BorderThickness="2" ClipToBounds="True"><Image x:Name="HeaderLogo" Stretch="UniformToFill"/></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0"><TextBlock Text="FlexHub" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="S I M P L E   •   U T I L E   •   E F F I C A C E" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="TipeeeButton" Content="&#x2665;" ToolTip="Soutenir FlexHub sur Tipeee" Style="{StaticResource HeaderIconButtonStyle}" Foreground="#FFE85D75" FontSize="21" Margin="0,0,7,0"/>
          <Button x:Name="GeneralSettingsButton" Content="⚙" ToolTip="Paramètres généraux" Style="{StaticResource HeaderIconButtonStyle}" Margin="0,0,7,0"/>
          <Button x:Name="HideHubButton" Content="—" ToolTip="Réduire dans la zone de notification" Style="{StaticResource HeaderIconButtonStyle}" FontSize="22" Margin="0,0,7,0"/>
          <Button x:Name="QuitHubButton" Content="✕" ToolTip="Quitter complètement le Hub" Style="{StaticResource CloseButtonStyle}"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="15">
        <StackPanel><TextBlock Text="FLEXHUB" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="Bold" Margin="4,4,0,14"/>
          <StackPanel x:Name="ActiveAppsPanel">
            <Button x:Name="CorrectorNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="✓  Correcteur universel"/>
            <Button x:Name="TranslatorNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="⇄  Traducteur universel"/>
            <Button x:Name="ResponseGeneratorNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="✦  Générateur de réponse"/>
            <Button x:Name="ReminderNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="◷  Rappel Top-Serveurs"/>
            <Button x:Name="NvidiaNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="⚡  Optimisation NVIDIA"/>
            <Button x:Name="XmpNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="▦  Surveillance XMP"/>
            <Button x:Name="ActionWheelNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="◉  Roue d’actions"/>
          </StackPanel>
          <StackPanel x:Name="DisabledAppsSection" Visibility="Collapsed">
            <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="2,18,2,14"/>
            <TextBlock Text="APPLICATIONS DÉSACTIVÉES" Foreground="{DynamicResource DisabledTextBrush}" FontSize="11" FontWeight="Bold" Margin="4,0,0,10"/>
            <StackPanel x:Name="DisabledAppsPanel"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="26">
        <Grid>
          <Grid x:Name="ReminderPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><TextBlock Text="Rappel Top-Serveurs" FontSize="27" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ToggleButton x:Name="ReminderEnabled" Style="{StaticResource ToggleStyle}"/><TextBlock Text="Activé" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Grid>
            <StackPanel Grid.Row="1" Margin="0,7,0,22">
              <TextBlock Text="Notification pour effectuer manuellement le vote Project Zomboid." Foreground="{StaticResource MutedBrush}"/>
              <TextBlock x:Name="LastReminderText" Foreground="{StaticResource AccentBrightBrush}" FontSize="12" Margin="0,7,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="2"><TextBlock Text="Intervalle en minutes" FontWeight="SemiBold"/><TextBox x:Name="ReminderInterval" Margin="0,7,0,14"/></StackPanel>
            <StackPanel Grid.Row="3"><TextBlock Text="Durée de la notification en secondes" FontWeight="SemiBold"/><TextBox x:Name="ReminderDuration" Margin="0,7,0,14"/></StackPanel>
            <StackPanel Grid.Row="4"><TextBlock Text="Adresse de la page" FontWeight="SemiBold"/><TextBox x:Name="ReminderUrl" Margin="0,7,0,0"/></StackPanel>
            <TextBlock x:Name="ReminderStatus" Grid.Row="5" Foreground="#FF7CE4C2" Margin="0,16" TextWrapping="Wrap"/>
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="TestReminder" Content="▶  Tester maintenant" Style="{StaticResource ButtonStyle}" Margin="0,0,10,0"/>
              <Button x:Name="SaveReminder" Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
          </Grid>

          <Grid x:Name="CorrectorPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><StackPanel><TextBlock Text="Correcteur universel" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Corrige le texte sélectionné dans les applications Windows." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ToggleButton x:Name="CorrectorEnabled" Style="{StaticResource ToggleStyle}"/><TextBlock Text="Activé" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Grid>
            <Border Grid.Row="1" Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,20"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel>
              <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Raccourci global" FontWeight="SemiBold"/><TextBlock Text="Cliquez dans la case puis utilisez la combinaison souhaitée." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,10,0"/></StackPanel><TextBox x:Name="HotkeyBox" Grid.Column="1" IsReadOnly="True" PreviewKeyDown="HotkeyBox_OnPreviewKeyDown"/></Grid>
              <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Moteur de correction" FontWeight="SemiBold"/><TextBlock Text="Le mode local ne transmet aucune donnée." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,10,0"/></StackPanel><ComboBox x:Name="EngineBox" Grid.Column="1" Height="42" SelectionChanged="EngineBox_OnSelectionChanged"><ComboBoxItem Content="Local Windows"/><ComboBoxItem Content="OpenAI"/><ComboBoxItem Content="LanguageTool local"/><ComboBoxItem Content="Google Gemini"/></ComboBox></Grid>
              <CheckBox x:Name="PreviewCheck" Content="Afficher un aperçu avant le remplacement" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>
              <CheckBox x:Name="FallbackCheck" Content="Revenir au correcteur local si OpenAI est indisponible" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,18"/>
              <Border x:Name="ApiPanel" Background="{DynamicResource PanelLightBrush}" CornerRadius="11" Padding="16" Visibility="Collapsed"><StackPanel>
                <TextBlock x:Name="ApiKeyLabel" Text="Clé API" FontWeight="SemiBold" Visibility="Collapsed"/><PasswordBox x:Name="ApiKeyBox" Height="42" Margin="0,7,0,12" Padding="12,8" Foreground="{DynamicResource TextBrush}" Visibility="Collapsed"/>
                <TextBlock Text="Modèle" FontWeight="SemiBold"/><TextBox x:Name="ModelBox" Margin="0,7,0,12"/>
                <StackPanel Orientation="Horizontal" Visibility="Collapsed"><Button x:Name="TestApi" Content="Tester la connexion" Style="{StaticResource ButtonStyle}" Margin="0,0,8,0"/><Button x:Name="ForgetApi" Content="Oublier la clé" Style="{StaticResource ButtonStyle}"/></StackPanel>
                <TextBlock x:Name="ApiPrivacyText" Text="La clé API est gérée depuis les paramètres généraux." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
              </StackPanel></Border>
              <Border x:Name="LanguageToolPanel" Background="{DynamicResource PanelLightBrush}" CornerRadius="11" Padding="16" Visibility="Collapsed"><StackPanel>
                <TextBlock Text="Adresse du serveur LanguageTool local" FontWeight="SemiBold"/>
                <TextBox x:Name="LanguageToolUrlBox" Margin="0,7,0,12"/>
                <Button x:Name="TestLanguageTool" Content="Tester le serveur local" Style="{StaticResource ButtonStyle}" HorizontalAlignment="Left"/>
                <TextBlock Text="LanguageTool doit être démarré sur votre ordinateur. Aucun texte n’est envoyé vers un service cloud." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
              </StackPanel></Border>
            </StackPanel></ScrollViewer>
            <TextBlock x:Name="CorrectorStatus" Grid.Row="3" Foreground="#FF7CE4C2" Margin="0,14" TextWrapping="Wrap"/>
            <Button x:Name="SaveCorrector" Grid.Row="4" Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"/>
          </Grid>

          <Grid x:Name="TranslatorPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><StackPanel><TextBlock Text="Traducteur universel" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Traduit le texte sélectionné dans les applications Windows." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ToggleButton x:Name="TranslatorEnabled" Style="{StaticResource ToggleStyle}"/><TextBlock Text="Activé" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Grid>
            <Border Grid.Row="1" Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,20"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel>
              <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Raccourci global" FontWeight="SemiBold"/><TextBlock Text="Sélectionnez du texte, puis utilisez ce raccourci." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,10,0"/></StackPanel><TextBox x:Name="TranslatorHotkeyBox" Grid.Column="1" IsReadOnly="True" PreviewKeyDown="TranslatorHotkeyBox_OnPreviewKeyDown"/></Grid>
              <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Service de traduction" FontWeight="SemiBold"/><TextBlock Text="Le texte sélectionné est envoyé au service choisi." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,10,0"/></StackPanel><ComboBox x:Name="TranslationEngineBox" Grid.Column="1" Height="42" SelectionChanged="TranslationEngineBox_OnSelectionChanged"><ComboBoxItem Content="DeepL"/><ComboBoxItem Content="Google Traduction"/><ComboBoxItem Content="Google Gemini"/><ComboBoxItem Content="LibreTranslate"/><ComboBoxItem Content="MyMemory (Translated)"/></ComboBox></Grid>
              <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Langue source" FontWeight="SemiBold"/><TextBlock Text="La détection automatique est recommandée." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,10,0"/></StackPanel><ComboBox x:Name="SourceLanguageBox" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Code"/></Grid>
              <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Text="Langue cible" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="TargetLanguageBox" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Code"/></Grid>
              <CheckBox x:Name="TranslationPreviewCheck" Content="Afficher un aperçu avant le remplacement" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,18"/>
              <Border Background="{DynamicResource PanelLightBrush}" CornerRadius="11" Padding="16"><StackPanel>
                <TextBlock x:Name="TranslationApiKeyLabel" Text="Clé API DeepL" FontWeight="SemiBold" Visibility="Collapsed"/><PasswordBox x:Name="TranslationApiKeyBox" Height="42" Margin="0,7,0,12" Padding="12,8" Foreground="{DynamicResource TextBrush}" Visibility="Collapsed"/>
                <CheckBox x:Name="DeepLFreeApiCheck" Content="Utiliser l’API DeepL Free" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>
                <StackPanel x:Name="TranslationOptionPanel" Visibility="Collapsed"><TextBlock x:Name="TranslationOptionLabel" FontWeight="SemiBold"/><TextBox x:Name="TranslationOptionBox" Margin="0,7,0,12"/></StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="Collapsed"><Button x:Name="TestTranslationApi" Content="Tester la connexion" Style="{StaticResource ButtonStyle}" Margin="0,0,8,0"/><Button x:Name="ForgetTranslationApi" Content="Oublier la clé" Style="{StaticResource ButtonStyle}"/></StackPanel>
                <TextBlock x:Name="TranslationPrivacyText" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
              </StackPanel></Border>
            </StackPanel></ScrollViewer>
            <TextBlock x:Name="TranslatorStatus" Grid.Row="3" Foreground="#FF7CE4C2" Margin="0,14" TextWrapping="Wrap"/>
            <Button x:Name="SaveTranslator" Grid.Row="4" Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"/>
          </Grid>

          <Grid x:Name="ResponseGeneratorPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><StackPanel><TextBlock Text="Générateur de réponse" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Génère une réponse au texte sélectionné dans une application Windows." Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ToggleButton x:Name="ResponseGeneratorEnabled" Style="{StaticResource ToggleStyle}"/><TextBlock Text="Activé" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Grid>
            <Border Grid.Row="1" Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,20"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel>
              <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Raccourci global" FontWeight="SemiBold"/><TextBlock Text="Sélectionnez un message, puis utilisez ce raccourci." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,10,0"/></StackPanel><TextBox x:Name="ResponseGeneratorHotkeyBox" Grid.Column="1" IsReadOnly="True" PreviewKeyDown="ResponseGeneratorHotkeyBox_OnPreviewKeyDown"/></Grid>
              <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Moteur d’IA" FontWeight="SemiBold"/><TextBlock Text="Utilise la clé déjà enregistrée pour ce fournisseur." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,10,0"/></StackPanel><ComboBox x:Name="ResponseGeneratorEngineBox" Grid.Column="1" SelectionChanged="ResponseGeneratorEngineBox_OnSelectionChanged"><ComboBoxItem Content="Google Gemini"/><ComboBoxItem Content="OpenAI"/></ComboBox></Grid>
              <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Ton de la réponse" FontWeight="SemiBold"/><TextBlock Text="Définit le style général utilisé par l’IA." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,10,0"/></StackPanel><ComboBox x:Name="ResponseGeneratorToneBox" Grid.Column="1"><ComboBoxItem Content="Naturel"/><ComboBoxItem Content="Professionnel"/><ComboBoxItem Content="Amical"/><ComboBoxItem Content="Concis"/></ComboBox></Grid>
              <TextBlock Text="Consigne personnalisée" FontWeight="SemiBold"/>
              <TextBox x:Name="ResponseGeneratorInstructionBox" Margin="0,7,0,14"/>
              <TextBlock Text="Modèle" FontWeight="SemiBold"/>
              <TextBox x:Name="ResponseGeneratorModelBox" Margin="0,7,0,14"/>
              <CheckBox x:Name="ResponseGeneratorPreviewCheck" Content="Afficher un aperçu avant le remplacement" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
            </StackPanel></ScrollViewer>
            <TextBlock x:Name="ResponseGeneratorStatus" Grid.Row="3" Foreground="{DynamicResource SuccessBrush}" Margin="0,14" TextWrapping="Wrap"/>
            <Button x:Name="SaveResponseGenerator" Grid.Row="4" Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"/>
          </Grid>

          <Grid x:Name="ActionWheelPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><StackPanel><TextBlock Text="Roue d’actions" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Accédez à la correction, la traduction et la génération de réponse avec un seul geste." Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ToggleButton x:Name="ActionWheelEnabled" Style="{StaticResource ToggleStyle}"/><TextBlock Text="Activé" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Grid>
            <Border Grid.Row="1" Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,20"/>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Raccourci de la roue" FontWeight="SemiBold"/><TextBlock Text="Appuyez brièvement, puis survolez une direction pour lancer l’action." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,12,0" TextWrapping="Wrap"/></StackPanel><TextBox x:Name="ActionWheelHotkeyBox" Grid.Column="1" IsReadOnly="True" PreviewKeyDown="ActionWheelHotkeyBox_OnPreviewKeyDown"/></Grid>
            <Border Grid.Row="3" Background="{DynamicResource PanelLightBrush}" CornerRadius="11" Padding="12" Margin="0,22,0,18">
              <Grid Width="350" Height="300" HorizontalAlignment="Center">
                <Ellipse Width="286" Height="286" Fill="#B51B1918" Stroke="{DynamicResource AccentBrightBrush}" StrokeThickness="2"/>
                <Ellipse Width="92" Height="92" Fill="{DynamicResource PanelBrush}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1"/>

                <Border Width="132" Height="56" CornerRadius="17" Background="{DynamicResource ButtonBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="✓" Foreground="{DynamicResource AccentBrightBrush}" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="CORRIGER" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel>
                </Border>
                <Border Width="132" Height="56" CornerRadius="17" Background="{DynamicResource ButtonBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,0,0">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="⇄" Foreground="{DynamicResource AccentBrightBrush}" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="TRADUIRE" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel>
                </Border>
                <Border Width="132" Height="56" CornerRadius="17" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrightBrush}" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="✦" Foreground="{DynamicResource TextBrush}" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="RÉPONDRE" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel>
                </Border>
                <Border Width="132" Height="56" CornerRadius="17" Background="{DynamicResource ButtonBrush}" BorderBrush="#FF9D4545" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="×" Foreground="#FFFF7F7F" FontSize="17" HorizontalAlignment="Center"/><TextBlock Text="ANNULER" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel>
                </Border>

                <StackPanel Width="84" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Répondre" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/><TextBlock Text="survol actif" Foreground="{DynamicResource MutedBrush}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
              </Grid>
            </Border>
            <TextBlock x:Name="ActionWheelStatus" Grid.Row="4" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>
            <Button x:Name="SaveActionWheel" Grid.Row="5" Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"/>
          </Grid>

          <Grid x:Name="NvidiaPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><StackPanel><TextBlock Text="Optimisation NVIDIA" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Applique ou restaure le profil global du pilote NVIDIA." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <ToggleButton x:Name="NvidiaEnabled" Style="{StaticResource ToggleStyle}"/><TextBlock Text="Activé" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel></Grid>
            <Border Grid.Row="1" Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,20"/>
            <Border Grid.Row="2" Background="#332F9E66" BorderBrush="#FFCA8B55" BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,0,0,12"><TextBlock Text="⚠ Vérifiez la liste des valeurs qui seront modifiées avant d’appliquer l’optimisation. Certains réglages NVIDIA sont globaux, expérimentaux ou dépendants de votre écran et de vos jeux." TextWrapping="Wrap"/></Border>
            <Border Grid.Row="3" Background="{DynamicResource PanelLightBrush}" CornerRadius="11" Padding="18"><StackPanel>
              <TextBlock Text="Profil global détecté" FontWeight="SemiBold" FontSize="16"/>
              <TextBlock x:Name="NvidiaHardwareInfo" Text="Lecture des informations NVIDIA…" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
              <TextBlock x:Name="NvidiaProfileState" Foreground="{StaticResource AccentBrightBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel></Border>
            <StackPanel Grid.Row="4" Margin="0,20,0,0">
              <TextBlock Text="Profils sauvegardés" FontWeight="SemiBold" FontSize="16"/>
              <TextBlock Text="Sélectionnez un profil pour l’appliquer ou le supprimer." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,8" TextWrapping="Wrap"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="NvidiaProfilesBox" MinWidth="300"/>
                <Button x:Name="ApplySelectedNvidiaProfile" Grid.Column="1" Content="Appliquer" Style="{StaticResource ButtonStyle}" Margin="10,0,0,0"/>
                <Button x:Name="DeleteSelectedNvidiaProfile" Grid.Column="2" Content="Supprimer" Style="{StaticResource ButtonStyle}" Margin="8,0,0,0"/>
              </Grid>
              <TextBlock x:Name="NvidiaLastAction" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="SaveNvidiaProfile" Content="Sauvegarder le profil actuel" Style="{StaticResource ButtonStyle}" Margin="0,0,10,0"/>
              <Button x:Name="RestoreNvidia" Content="Restaurer mon profil" Style="{StaticResource ButtonStyle}" Margin="0,0,10,0"/>
              <Button x:Name="OptimizeNvidia" Content="Optimiser NVIDIA" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
          </Grid>

          <Grid x:Name="XmpPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><StackPanel><TextBlock Text="Surveillance XMP" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Contrôle périodiquement la fréquence configurée de votre mémoire." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ToggleButton x:Name="XmpEnabled" Style="{StaticResource ToggleStyle}"/><TextBlock Text="Activé" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Grid>
            <Border Grid.Row="1" Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,20"/>
            <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Text="Type de mémoire" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="MemoryTypeBox" Grid.Column="1" SelectionChanged="MemoryTypeBox_OnSelectionChanged"><ComboBoxItem Content="DDR4"/><ComboBoxItem Content="DDR5"/></ComboBox></Grid>
            <StackPanel Grid.Row="3"><CheckBox x:Name="XmpCustomSpeedCheck" Foreground="{DynamicResource TextBrush}" Content="Utiliser une valeur minimale personnalisée" Checked="XmpCustomSpeedChanged" Unchecked="XmpCustomSpeedChanged"/><TextBox x:Name="XmpExpectedSpeedBox" Margin="24,7,0,14" Width="196" HorizontalAlignment="Left"/></StackPanel>
            <StackPanel Grid.Row="4"><TextBlock Text="Intervalle de vérification (minutes)" FontWeight="SemiBold"/><TextBox x:Name="XmpIntervalBox" Margin="0,7,0,14"/></StackPanel>
            <Border Grid.Row="5" Background="{DynamicResource PanelLightBrush}" CornerRadius="11" Padding="18" Margin="0,4,0,18"><StackPanel>
              <TextBlock Text="État de la mémoire" FontWeight="SemiBold" FontSize="16"/>
              <TextBlock x:Name="XmpStatus" Foreground="{StaticResource AccentBrightBrush}" Margin="0,9,0,0" TextWrapping="Wrap"/>
              <TextBlock x:Name="XmpLastCheck" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,7,0,0"/>
              <TextBlock Text="Cette détection compare la fréquence configurée à la valeur attendue. Le drapeau XMP du BIOS n’est pas toujours accessible depuis Windows." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel></Border>
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="TestXmp" Content="Vérifier maintenant" Style="{StaticResource ButtonStyle}" Margin="0,0,10,0"/>
              <Button x:Name="SaveXmp" Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
          </Grid>

          <Grid x:Name="GeneralSettingsPage" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="Paramètres généraux" FontSize="27" FontWeight="SemiBold"/>
              <TextBlock Text="Personnalisez le comportement et l’apparence du Hub." Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/>
            </StackPanel>
            <Border Grid.Row="1" Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,20"/>
            <ScrollViewer x:Name="GeneralSettingsScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="GeneralSettingsScrollViewer_OnPreviewMouseWheel"><StackPanel Margin="0,0,10,0">
              <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Ouvrir au démarrage du PC" FontWeight="SemiBold"/><TextBlock Text="Lance automatiquement le Hub à l’ouverture de votre session Windows." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,18,0"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ToggleButton x:Name="StartWithWindowsToggle" Style="{StaticResource ToggleStyle}"/><TextBlock x:Name="StartWithWindowsLabel" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
              </Grid>
              <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Taille de la police" FontWeight="SemiBold"/><TextBlock Text="Ajuste la taille des textes et des champs de saisie." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,18,0"/></StackPanel>
                <ComboBox x:Name="FontSizeBox" Grid.Column="1"><ComboBoxItem Content="Petit"/><ComboBoxItem Content="Moyen"/><ComboBoxItem Content="Grand"/></ComboBox>
              </Grid>
              <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Thème de l’application" FontWeight="SemiBold"/><TextBlock Text="Choisissez une interface claire ou sombre." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,18,0"/></StackPanel>
                <ComboBox x:Name="ThemeBox" Grid.Column="1"><ComboBoxItem Content="Sombre"/><ComboBoxItem Content="Clair"/></ComboBox>
              </Grid>
              <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,4,0,18"/>
              <TextBlock Text="Clés API" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="Les clés sont chiffrées pour votre compte Windows et partagées entre les modules concernés." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,14" TextWrapping="Wrap"/>
              <CheckBox x:Name="AiConsentCheck" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14" Content="J’accepte que le texte sélectionné soit transmis au fournisseur choisi lorsque j’utilise une fonction en ligne."/>
              <TextBlock Text="OpenAI" FontWeight="SemiBold"/><PasswordBox x:Name="GeneralOpenAiKeyBox" Height="42" Padding="12,8" Margin="0,7,0,12"/>
              <TextBlock Text="Google Gemini" FontWeight="SemiBold"/><PasswordBox x:Name="GeneralGeminiKeyBox" Height="42" Padding="12,8" Margin="0,7,0,12"/>
              <TextBlock Text="DeepL" FontWeight="SemiBold"/><PasswordBox x:Name="GeneralDeepLKeyBox" Height="42" Padding="12,8" Margin="0,7,0,12"/>
              <TextBlock Text="Google Traduction" FontWeight="SemiBold"/><PasswordBox x:Name="GeneralGoogleTranslateKeyBox" Height="42" Padding="12,8" Margin="0,7,0,12"/>
              <TextBlock Text="LibreTranslate (facultative selon le serveur)" FontWeight="SemiBold"/><PasswordBox x:Name="GeneralLibreTranslateKeyBox" Height="42" Padding="12,8" Margin="0,7,0,4"/>
              <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,18,0,18"/>
              <TextBlock Text="Version et mises à jour" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock x:Name="CurrentVersionText" Foreground="{DynamicResource AccentBrightBrush}" Margin="0,5,0,14"/>
              <TextBlock Text="Historique des versions" FontWeight="SemiBold"/>
              <Grid Margin="0,8,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="VersionHistoryBox" MinWidth="220"/>
                <Button x:Name="OpenPatchNotes" Grid.Column="1" Content="Voir le patchnote" Style="{StaticResource ButtonStyle}" Margin="10,0,0,0"/>
              </Grid>
              <TextBlock Text="Éditeur : Flexron" FontWeight="SemiBold"/>
              <TextBlock Text="Support : retrouvez-moi sur Discord — pseudo Flexron" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,12"/>
              <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="UpdateStatus" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,12,0"/>
                <Button x:Name="DownloadUpdate" Grid.Column="1" Content="Ouvrir la nouvelle version" Style="{StaticResource ButtonStyle}" Visibility="Collapsed" Margin="0,0,10,0"/>
                <Button x:Name="CheckUpdates" Grid.Column="2" Content="Vérifier les mises à jour" Style="{StaticResource PrimaryButtonStyle}"/>
              </Grid>
              <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,12,0,18"/>
              <Border Background="{DynamicResource PanelLightBrush}" BorderBrush="#FF9D4545" BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,0,0,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0"><TextBlock Text="Effacer toutes les données personnelles" FontWeight="SemiBold" Foreground="#FFFF7F7F"/><TextBlock Text="Supprime les réglages, les clés API, les journaux et tous les profils NVIDIA sauvegardés. Cette action est irréversible." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                <Button x:Name="DeleteAllPersonalData" Grid.Column="1" Content="Tout effacer" Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"/>
              </Grid></Border>
            </StackPanel></ScrollViewer>
            <TextBlock x:Name="GeneralSettingsStatus" Grid.Row="3" Foreground="{DynamicResource SuccessBrush}" Margin="0,16" TextWrapping="Wrap"/>
            <Button x:Name="SaveGeneralSettings" Grid.Row="4" Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"/>
          </Grid>

        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
