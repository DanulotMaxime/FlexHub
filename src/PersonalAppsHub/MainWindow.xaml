<Window x:Class="PersonalAppsHub.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlexHub" Width="1120" Height="780" MinWidth="1000" MinHeight="720" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource BaseFontSize}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="60" Height="60" CornerRadius="30" BorderBrush="{StaticResource AccentBrightBrush}" BorderThickness="2" ClipToBounds="True"><Image x:Name="HeaderLogo" Stretch="UniformToFill"/></Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0"><TextBlock Text="FlexHub" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="S I M P L E   •   U T I L E   •   E F F I C A C E" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/></StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="TipeeeButton" Content="&#x2665;" ToolTip="Soutenir FlexHub sur Tipeee" Style="{StaticResource HeaderIconButtonStyle}" Foreground="#FFE85D75" FontSize="21" Margin="0,0,7,0"/>
          <Button x:Name="GeneralSettingsButton" Content="⚙" ToolTip="Paramètres généraux" Style="{StaticResource HeaderIconButtonStyle}" Margin="0,0,7,0"/>
          <Button x:Name="HideHubButton" Content="—" ToolTip="Réduire dans la zone de notification" Style="{StaticResource HeaderIconButtonStyle}" FontSize="22" Margin="0,0,7,0"/>
          <Button x:Name="QuitHubButton" Content="✕" ToolTip="Quitter complètement le Hub" Style="{StaticResource CloseButtonStyle}"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="15">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="FLEXHUB" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="Bold" Margin="4,4,0,14"/>
          <ScrollViewer x:Name="SidebarScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                        PanningMode="VerticalOnly" CanContentScroll="False" PreviewMouseWheel="SidebarScrollViewer_OnPreviewMouseWheel">
          <StackPanel Margin="0,0,5,0">
            <StackPanel x:Name="ActiveAppsPanel">
            <StackPanel x:Name="TextToolsSection">
              <Button x:Name="TextToolsToggle" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Stretch" Padding="11,8" Margin="0,0,0,5">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Aa" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="Outils de texte" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="TextToolsModuleCount" Text="7 modules" Foreground="{DynamicResource AccentBrightBrush}" FontSize="10" Margin="0,1,0,0"/></StackPanel>
                  <TextBlock x:Name="TextToolsChevron" Grid.Column="2" Text="›" Foreground="{DynamicResource TextBrush}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                </Grid>
              </Button>
              <StackPanel x:Name="TextToolsPanel" Margin="0,0,0,4" Visibility="Collapsed">
            <Button x:Name="CorrectorNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="✓  Correcteur universel"/>
            <Button x:Name="ReformulateNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="↻  Reformuler"/>
            <Button x:Name="SimplifyNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="≡  Simplifier"/>
            <Button x:Name="ConversationSummaryNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="☷  Résumer conversation"/>
            <Button x:Name="WordDefinitionNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="?  Définition d’un mot"/>
            <Button x:Name="TranslatorNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="⇄  Traducteur universel"/>
            <Button x:Name="ResponseGeneratorNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="✦  Générateur de réponse"/>
              </StackPanel>
              <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="2,4,2,12"/>
            </StackPanel>
            <StackPanel x:Name="MonitoringGamesSection">
              <Button x:Name="MonitoringGamesToggle" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Stretch" Padding="11,8" Margin="0,0,0,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><TextBlock Text="▥" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Jeux et monitoring" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="MonitoringGamesModuleCount" Text="5 modules" Foreground="{DynamicResource AccentBrightBrush}" FontSize="10"/></StackPanel><TextBlock x:Name="MonitoringGamesChevron" Grid.Column="2" Text="›" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Button>
              <StackPanel x:Name="MonitoringGamesPanel" Margin="0,0,0,4" Visibility="Collapsed"><Button x:Name="MonitoringNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="▥  Monitoring PC"/><Button x:Name="GameSessionsNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="▶  Sessions de jeu"/><Button x:Name="NetworkMonitoringNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="⌁  Monitoring réseau"/><Button x:Name="NvidiaNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="⚡  Optimisation NVIDIA"/><Button x:Name="XmpNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="▦  Surveillance XMP"/></StackPanel>
              <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="2,4,2,12"/>
            </StackPanel>
            <StackPanel x:Name="MaintenanceSection">
              <Button x:Name="MaintenanceToggle" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Stretch" Padding="11,8" Margin="0,0,0,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><TextBlock Text="♲" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Entretien du PC" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="MaintenanceModuleCount" Text="4 modules" Foreground="{DynamicResource AccentBrightBrush}" FontSize="10"/></StackPanel><TextBlock x:Name="MaintenanceChevron" Grid.Column="2" Text="›" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Button>
              <StackPanel x:Name="MaintenancePanel" Margin="0,0,0,4" Visibility="Collapsed"><Button x:Name="CleanupNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="♲  Nettoyage temporaire"/><Button x:Name="DuplicateFilesNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="≋  Fichiers en double"/><Button x:Name="StorageHealthNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="▰  Santé du stockage"/><Button x:Name="StartupAuditNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="▶  Audit du démarrage"/></StackPanel>
              <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="2,4,2,12"/>
            </StackPanel>
            <StackPanel x:Name="AutomationSection">
              <Button x:Name="AutomationToggle" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Stretch" Padding="11,8" Margin="0,0,0,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><TextBlock Text="◉" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Utilitaires" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="AutomationModuleCount" Text="3 modules" Foreground="{DynamicResource AccentBrightBrush}" FontSize="10"/></StackPanel><TextBlock x:Name="AutomationChevron" Grid.Column="2" Text="›" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Button>
              <StackPanel x:Name="AutomationPanel" Margin="0,0,0,4" Visibility="Collapsed"><Button x:Name="ReminderNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="◷  Rappel Top-Serveurs"/><Button x:Name="ActionWheelNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="◉  Roue d’actions"/><Button x:Name="KeyboardLayoutNav" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Left" Content="⌨  Azerty&gt;Querty auto"/></StackPanel>
              <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="2,4,2,12"/>
            </StackPanel>
            </StackPanel>
            <StackPanel x:Name="DisabledAppsSection" Visibility="Collapsed">
              <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="2,18,2,14"/>
              <TextBlock Text="APPLICATIONS DÉSACTIVÉES" Foreground="{DynamicResource DisabledTextBrush}" FontSize="11" FontWeight="Bold" Margin="4,0,0,10" TextWrapping="Wrap"/>
              <StackPanel x:Name="DisabledAppsPanel"/>
            </StackPanel>
          </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
      <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="26">
        <Grid>
          <Grid x:Name="ReminderPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><TextBlock Text="Rappel Top-Serveurs" FontSize="27" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ToggleButton x:Name="ReminderEnabled" Style="{StaticResource ToggleStyle}"/><TextBlock Text="Activé" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Grid>
            <StackPanel Grid.Row="1" Margin="0,7,0,22">
              <TextBlock Text="Notification pour effectuer manuellement le vote Project Zomboid." Foreground="{StaticResource MutedBrush}"/>
              <TextBlock x:Name="LastReminderText" Foreground="{StaticResource AccentBrightBrush}" FontSize="12" Margin="0,7,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="2"><TextBlock Text="Intervalle en minutes" FontWeight="SemiBold"/><TextBox x:Name="ReminderInterval" Margin="0,7,0,14"/></StackPanel>
            <StackPanel Grid.Row="3"><TextBlock Text="Durée de la notification en secondes" FontWeight="SemiBold"/><TextBox x:Name="ReminderDuration" Margin="0,7,0,14"/></StackPanel>
            <StackPanel Grid.Row="4"><TextBlock Text="Adresse de la page" FontWeight="SemiBold"/><TextBox x:Name="ReminderUrl" Margin="0,7,0,0"/></StackPanel>
            <TextBlock x:Name="ReminderStatus" Grid.Row="5" Foreground="#FF7CE4C2" Margin="0,16" TextWrapping="Wrap"/>
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="TestReminder" Content="▶  Tester maintenant" Style="{StaticResource ButtonStyle}" Margin="0,0,10,0"/>
              <Button x:Name="SaveReminder" Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
          </Grid>

          <Grid x:Name="CorrectorPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><StackPanel><TextBlock Text="Correcteur universel" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Corrige le texte sélectionné dans les applications Windows." Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ToggleButton x:Name="CorrectorEnabled" Style="{StaticResource ToggleStyle}"/><TextBlock Text="Activé" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Grid>
            <Border Grid.Row="1" Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,20"/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="ContentScrollViewer_OnPreviewMouseWheel"><StackPanel>
              <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Raccourci global" FontWeight="SemiBold"/><TextBlock Text="Cliquez dans la case puis utilisez la combinaison souhaitée." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,10,0"/></StackPanel><TextBox x:Name="HotkeyBox" Grid.Column="1" IsReadOnly="True" PreviewKeyDown="HotkeyBox_OnPreviewKeyDown"/></Grid>
              <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Moteur de correction" FontWeight="SemiBold"/><TextBlock Text="Le mode local ne transmet aucune donnée." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,10,0"/></StackPanel><ComboBox x:Name="EngineBox" Grid.Column="1" Height="42" SelectionChanged="EngineBox_OnSelectionChanged"><ComboBoxItem Content="Local Windows"/><ComboBoxItem Content="OpenAI"/><ComboBoxItem Content="LanguageTool local"/><ComboBoxItem Content="Google Gemini"/></ComboBox></Grid>
              <CheckBox x:Name="PreviewCheck" Content="Afficher un aperçu avant le remplacement" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>
              <CheckBox x:Name="FallbackCheck" Content="Revenir au correcteur local si OpenAI est indisponible" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,18"/>
              <Border x:Name="ApiPanel" Background="{DynamicResource PanelLightBrush}" CornerRadius="11" Padding="16" Visibility="Collapsed"><StackPanel>
                <TextBlock x:Name="ApiKeyLabel" Text="Clé API" FontWeight="SemiBold" Visibility="Collapsed"/><PasswordBox x:Name="ApiKeyBox" Height="42" Margin="0,7,0,12" Padding="12,8" Foreground="{DynamicResource TextBrush}" Visibility="Collapsed"/>
                <TextBlock Text="Modèle" FontWeight="SemiBold"/><TextBox x:Name="ModelBox" Margin="0,7,0,12"/>
                <StackPanel Orientation="Horizontal" Visibility="Collapsed"><Button x:Name="TestApi" Content="Tester la connexion" Style="{StaticResource ButtonStyle}" Margin="0,0,8,0"/><Button x:Name="ForgetApi" Content="Oublier la clé" Style="{StaticResource ButtonStyle}"/></StackPanel>
                <TextBlock x:Name="ApiPrivacyText" Text="La clé API est gérée depuis les paramètres généraux." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
              </StackPanel></Border>
              <Border x:Name="LanguageToolPanel" Background="{DynamicResource PanelLightBrush}" CornerRadius="11" Padding="16" Visibility="Collapsed"><StackPanel>
                <TextBlock Text="Adresse du serveur LanguageTool local" FontWeight="SemiBold"/>
                <TextBox x:Name="LanguageToolUrlBox" Margin="0,7,0,12"/>
                <Button x:Name="TestLanguageTool" Content="Tester le serveur local" Style="{StaticResource ButtonStyle}" HorizontalAlignment="Left"/>
                <TextBlock Text="LanguageTool doit être démarré sur votre ordinateur. Aucun texte n’est envoyé vers un service cloud." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
              </StackPanel></Border>
            </StackPanel></ScrollViewer>
            <TextBlock x:Name="CorrectorStatus" Grid.Row="3" Foreground="#FF7CE4C2" Margin="0,14" TextWrapping="Wrap"/>
            <Button x:Name="SaveCorrector" Grid.Row="4" Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Right"/>
          </Grid>

          <Grid x:Name="ReformulatePage" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <StackPanel><TextBlock Text="Reformuler" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Réécrit le texte sélectionné en conservant son sens, sa langue et ses informations." Foreground="{DynamicResource MutedBrush}" Margin="0,7,150,0" TextWrapping="Wrap"/></StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ToggleButton x:Name="ReformulatorEnabled" Style="{StaticResource ToggleStyle}"/><TextBlock Text="Activé" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </Grid>
            <Border Grid.Row="1" Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,20"/>
            <StackPanel Grid.Row="2">
              <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Style de reformulation" FontWeight="SemiBold"/><TextBlock Text="Le texte conserve son sens mais adopte ce style." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,12,0"/></StackPanel><ComboBox x:Name="ReformulationStyleBox" Grid.Column="1"><ComboBoxItem Content="Email professionnel"/><ComboBoxItem Content="Message décontracté"/><ComboBoxItem Content="LinkedIn enthousiaste"/><ComboBoxItem Content="LinkedIn cringe"/><ComboBoxItem Content="Discours médiéval"/><ComboBoxItem Content="Très formel"/><ComboBoxItem Content="Amical"/><ComboBoxItem Content="Direct et concis"/><ComboBoxItem Content="Diplomatique"/><ComboBoxItem Content="Humoristique"/><ComboBoxItem Content="Commercial convaincant"/><ComboBoxItem Content="Académique"/><ComboBoxItem Content="Poétique"/><ComboBoxItem Content="Fantasy"/><ComboBoxItem Content="Discours motivant"/><ComboBoxItem Content="Vieux français"/><ComboBoxItem Content="Français très complexe"/><ComboBoxItem Content="Scientifique"/><ComboBoxItem Content="Méchant"/><ComboBoxItem Content="Insultant"/><ComboBoxItem Content="Insultant mais discret"/><ComboBoxItem Content="Méchant de film"/></ComboBox></Grid>
              <Border Background="{DynamicResource PanelLightBrush}" CornerRadius="11" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Comment l’utiliser" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="1. Sélectionnez un texte dans une application Windows.&#x0a;2. Ouvrez la roue d’actions.&#x0a;3. Survolez Reformuler pendant un court instant.&#x0a;4. Vérifiez le résultat avant de remplacer le texte." Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="22"/>
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource PanelLightBrush}" CornerRadius="11" Padding="18">
                <StackPanel>
                  <TextBlock Text="Configuration utilisée" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock x:Name="ReformulateConfigurationText" Foreground="{DynamicResource AccentBrightBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                  <TextBlock Text="La clé API, le modèle, le ton et l’aperçu sont partagés avec le Générateur de réponse." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
              <Button x:Name="OpenReformulateWheelSettings" Content="Roue d’actions" Style="{StaticResource ButtonStyle}" Margin="0,0,9,0"/>
              <Button x:Name="OpenReformulateAiSettings" Content="Réglages IA" Style="{StaticResource ButtonStyle}" Margin="0,0,9,0"/>
              <Button x:Name="SaveReformulator" Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
          </Grid>

          <Grid x:Name="SimplifyPage" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <StackPanel><TextBlock Text="Simplifier" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Transforme un texte complexe en une version claire, accessible et fidèle aux informations d’origine." Foreground="{DynamicResource MutedBrush}" Margin="0,7,150,0" TextWrapping="Wrap"/></StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ToggleButton x:Name="SimplifierEnabled" Style="{StaticResource ToggleStyle}"/><TextBlock Text="Activé" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </Grid>
            <Border Grid.Row="1" Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,20"/>
            <StackPanel Grid.Row="2">
              <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Niveau de simplification" FontWeight="SemiBold"/><TextBlock Text="Choisissez la quantité de détails et la difficulté du vocabulaire." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,12,0"/></StackPanel><ComboBox x:Name="SimplificationLevelBox" Grid.Column="1"><ComboBoxItem Content="Ultra simplifié"/><ComboBoxItem Content="Beaucoup simplifié"/><ComboBoxItem Content="Simplifié"/></ComboBox></Grid>
              <Border Background="{DynamicResource PanelLightBrush}" CornerRadius="11" Padding="18" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="Comment l’utiliser" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="1. Sélectionnez le texte difficile à comprendre.&#x0a;2. Ouvrez la roue d’actions.&#x0a;3. Survolez Simplifier pendant un court instant.&#x0a;4. Vérifiez la version simplifiée avant le remplacement." Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="22"/>
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource PanelLightBrush}" CornerRadius="11" Padding="18">
                <StackPanel>
                  <TextBlock Text="Configuration utilisée" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock x:Name="SimplifyConfigurationText" Foreground="{DynamicResource AccentBrightBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                  <TextBlock Text="La simplification conserve la langue et les faits importants. Le moteur et l’aperçu sont partagés avec le Générateur de réponse." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
              <Button x:Name="OpenSimplifyWheelSettings" Content="Roue d’actions" Style="{StaticResource ButtonStyle}" Margin="0,0,9,0"/>
              <Button x:Name="OpenSimplifyAiSettings" Content="Réglages IA" Style="{StaticResource ButtonStyle}" Margin="0,0,9,0"/>
              <Button x:Name="SaveSimplifier" Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
          </Grid>

          <Grid x:Name="ConversationSummaryPage" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <StackPanel><TextBlock Text="Résumer une conversation" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Extrait l’essentiel d’une conversation Discord, Slack, Teams ou de tout autre texte sélectionné." Foreground="{DynamicResource MutedBrush}" Margin="0,7,150,0" TextWrapping="Wrap"/></StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><ToggleButton x:Name="ConversationSummarizerEnabled" Style="{StaticResource ToggleStyle}"/><TextBlock Text="Activé" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
            </Grid>
            <Border Grid.Row="1" Height="1" Background="{DynamicResource SeparatorBrush}" Margin="0,20"/>
            <StackPanel Grid.Row="2">
              <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Longueur du résumé" FontWeight="SemiBold"/><TextBlock Text="Adapte le niveau de détail du résultat." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,12,0"/></StackPanel><ComboBox x:Name="ConversationSummaryLengthBox" Grid.Column="1"><ComboBoxItem Content="Très court - 3 lignes"/><ComboBoxItem Content="Court - 5 lignes"/><ComboBoxItem Content="Moyen - 10 lignes"/><ComboBoxItem Content="Détaillé"/></ComboBox></Grid>
              <CheckBox x:Name="ConversationSummaryPreserveNamesCheck" Content="Conserver les noms des participants lorsqu’ils sont utiles" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>
              <CheckBox x:Name="ConversationSummaryIncludeActionsCheck" Content="Extraire les décisions et les tâches à faire" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,18"/>
              <Border Background="{DynamicResource PanelLightBrush}" CornerRadius="11" Padding="18">
                <StackPanel><TextBlock Text="Utilisation" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Sélectionnez ou copiez la conversation dans une zone de texte, ouvrez la roue d’actions puis choisissez Résumer une conversation. Un aperçu modifiable sera affiché avant le remplacement." Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,0" TextWrapping="Wrap"/><TextBlock x:Name="ConversationSummaryConfigurationText" Foreground="{DynamicResource AccentBrightBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel>
              </Border>
            </StackPanel>
            <TextBlock x:Name="ConversationSummaryStatus" Grid.Row="3" Foreground="{DynamicResource SuccessBrush}" Margin="0,14" TextWrapping="Wrap"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="OpenConversationSummaryAiSettings" Content="Réglages IA" Style="{StaticResource ButtonStyle}" Margin="0,0,9,0"/>
              <Button x:Name="SaveConversationSummary" Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
          </Grid>

          <Grid x:Name="WordDefinitionPage" Visibility="Collapsed">
