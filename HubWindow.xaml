<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlexHub" Width="980" Height="650" MinWidth="850" MinHeight="570"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#FF1A1918"/>
    <SolidColorBrush x:Key="PanelLight" Color="#FF24211F"/>
    <SolidColorBrush x:Key="Accent" Color="#FFD58B4C"/>
    <SolidColorBrush x:Key="AccentBright" Color="#FFF0AE72"/>
    <SolidColorBrush x:Key="Cream" Color="#FFFFDFC0"/>
    <SolidColorBrush x:Key="Copper" Color="#FFC77745"/>
    <SolidColorBrush x:Key="Muted" Color="#FFBDB7B2"/>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FF111212"/><Setter Property="Foreground" Value="#FFF7F3EF"/>
      <Setter Property="BorderBrush" Value="#FF554D47"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,0"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="TextBox">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Foreground" Value="#FFF7F1EB"/><Setter Property="Background" Value="#FF26221F"/>
      <Setter Property="BorderBrush" Value="#FF55483E"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="18,11"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#FF3A2C22"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBright}"/>
    </Style>

    <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Width" Value="38"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="5,0,0,0"/><Setter Property="FontSize" Value="17"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
      <Setter Property="Width" Value="58"/><Setter Property="Height" Value="30"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Grid>
          <Border x:Name="Track" CornerRadius="15" Background="#FF49433E" BorderBrush="#FF665B53" BorderThickness="1"/>
          <Ellipse x:Name="Thumb" Width="24" Height="24" Fill="#FFF4E6CA" HorizontalAlignment="Left" Margin="3,0,0,0">
            <Ellipse.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.35"/></Ellipse.Effect>
          </Ellipse>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBright}"/>
            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#FFF1ECE8"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="15"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="ItemBorder" Background="#FF1B1A19" BorderBrush="#FF3D3935" BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}">
          <DockPanel><TextBlock Text="▥" Foreground="{StaticResource AccentBright}" FontSize="20" Margin="0,0,12,0"/><ContentPresenter VerticalAlignment="Center"/></DockPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#FF3A2B21"/><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBright}"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#FF2B2420"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>

  <Border Background="#FF0E0F0F" BorderBrush="#FF4A4039" BorderThickness="1" CornerRadius="18">
    <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.55"/></Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Name="TitleBar" Grid.Row="0" Background="#FF151515" CornerRadius="18,18,0,0" BorderBrush="#FF56483D" BorderThickness="0,0,0,1">
        <Grid Margin="22,0,18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="58" Height="58" CornerRadius="29" BorderBrush="{StaticResource Cream}" BorderThickness="2" ClipToBounds="True">
            <Image Name="LogoImage" Stretch="UniformToFill"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
            <TextBlock Text="FlexHub" Foreground="#FFF5F7F7" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="S I M P L E   •   U T I L E   •   E F F I C A C E" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Name="MinimizeButton" Content="—" Style="{StaticResource WindowButton}"/>
            <Button Name="CloseWindowButton" Content="×" Style="{StaticResource WindowButton}"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#FF141414" CornerRadius="14" BorderBrush="#FF403A35" BorderThickness="1" Padding="16">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="FLEXHUB" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="Bold" Margin="4,3,0,14"/>
            <ListBox Name="AppList" Grid.Row="1" Background="Transparent" BorderThickness="0"/>
          </Grid>
        </Border>

        <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="14" BorderBrush="#FF4D433C" BorderThickness="1" Padding="25">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Name="AppTitle" Foreground="#FFF5F7F7" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Name="AppDescription" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,7,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="20,2,0,0">
                <ToggleButton Name="EnabledCheck" Style="{StaticResource ToggleSwitch}"/>
                <TextBlock Text="Activée" Foreground="#FFDDE8EA" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0"/>
              </StackPanel>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="#FF4A4039" Margin="0,20,0,20"/>
            <StackPanel Grid.Row="2">
              <Border Background="{StaticResource PanelLight}" CornerRadius="11" Padding="16" Margin="0,0,0,11">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Intervalle (minutes)" Foreground="#FFF4F7F7" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="Fréquence du rappel" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                  <TextBox Name="IntervalBox" Grid.Column="1" Height="42"/>
                </Grid>
              </Border>
              <Border Background="{StaticResource PanelLight}" CornerRadius="11" Padding="16" Margin="0,0,0,11">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Durée de la notification" Foreground="#FFF4F7F7" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="Temps d’affichage en secondes" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                  <TextBox Name="DurationBox" Grid.Column="1" Height="42"/>
                </Grid>
              </Border>
              <Border Background="{StaticResource PanelLight}" CornerRadius="11" Padding="16">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="Adresse de la page" Foreground="#FFF4F7F7" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="Page ouverte par le rappel" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                  <TextBox Name="UrlBox" Grid.Column="1" Height="42"/>
                </Grid>
              </Border>
              <Border Name="StatusPanel" Background="#FF123B36" BorderBrush="#FF247F6A" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock Name="StatusText" Foreground="#FF7CE4C2" TextWrapping="Wrap"/>
              </Border>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
              <Button Name="RunButton" Content="▶  Tester maintenant" Style="{StaticResource ActionButton}" Margin="0,0,10,0"/>
              <Button Name="SaveButton" Content="Enregistrer" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
